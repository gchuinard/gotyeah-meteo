# ── Environnement ─────────────────────────────────────────────────────────────
# "production" active les garde-fous (ex : refus de démarrer avec un SECRET_KEY par défaut).
ENVIRONMENT=production
# Exposer la doc interactive OpenAPI (Swagger /docs, /redoc, /openapi.json) ?
# false par défaut (sécurité). Mettre true UNIQUEMENT en développement local.
ENABLE_DOCS=false

# ── OpenWeatherMap ────────────────────────────────────────────────────────────
OWM_API_KEY=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=weathernow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=weathernow
DATABASE_URL=postgresql+asyncpg://weathernow:changeme@weathernow-db:5432/weathernow

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-generate-a-real-secret

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
